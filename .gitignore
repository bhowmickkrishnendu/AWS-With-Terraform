# Ignore files generated by Terraform
*.tfstate
*.tfstate.backup
*.tfplan

# Ignore any temporary files or editor files
*~
*.swp
*.bak

# Ignore the .terraform directory created by terraform init
.terraform/

# Ignore any credentials or configuration files
*.pem
# Ignore all tfvars except specific one
*.auto.tfvars
secret.tfvars
*.secrets.tfvars
!v2_2025/AWS-Main/IAM_Role_Policy_Root/terraform.tfvars
*.env
*.key

# Ignore any files generated by IDEs or editors
.idea/
.vscode/

# Ignore any compiled files
*.exe

# Keep legacy example lock files ignored. Commit locks for active root modules.
*.lock.hcl
!stacks/*/.terraform.lock.hcl
!bootstrap/.terraform.lock.hcl

# Local Phase 0 recovery metadata; never commit state object version IDs.
.phase0-private/
.phase1-private/
local_docs
/scripts/
